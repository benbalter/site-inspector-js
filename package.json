{
  "name": "site-inspector",
  "version": "0.1.0",
  "description": "Inspect a domain's technology, security, and capabilities",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./assess": {
      "types": "./dist/assess.d.ts",
      "import": "./dist/assess.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "site-inspector": "./dist/cli.js"
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint src web/src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "site-inspector",
    "domain",
    "security",
    "headers",
    "https",
    "dns",
    "technology",
    "web"
  ],
  "author": "Ben Balter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benbalter/site-inspector-js.git"
  },
  "bugs": "https://github.com/benbalter/site-inspector-js/issues",
  "homepage": "https://github.com/benbalter/site-inspector-js#readme",
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@tgwf/co2": "0.19.0",
    "axe-core": "^4.13.0",
    "cache-control-parser": "^2.2.0",
    "chalk": "^6.0.1",
    "cheerio": "^1.2.0",
    "chrome-launcher": "^1.2.2",
    "commander": "^15.0.0",
    "csp_evaluator": "^1.1.8",
    "geoip-lite": "^2.0.3",
    "jsdom": "^30.1.1",
    "lighthouse": "^13.5.0",
    "open-graph-scraper": "^6.12.0",
    "robots-parser": "^3.0.1",
    "ssl-checker": "^3.0.1",
    "structured-headers": "2.1.0",
    "wappalyzer-core": "^6.10.66",
    "whois-json": "^2.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.5"
  }
}
