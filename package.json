{
  "name": "site-inspector",
  "version": "0.1.0",
  "description": "Inspect a domain's technology, security, and capabilities",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./assess": {
      "import": "./dist/assess.js",
      "types": "./dist/assess.d.ts"
    }
  },
  "bin": {
    "site-inspector": "./dist/cli.js"
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "site-inspector",
    "domain",
    "security",
    "headers",
    "https",
    "dns",
    "technology",
    "web"
  ],
  "author": "Ben Balter",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "axe-core": "^4.13.0",
    "cache-control-parser": "^2.2.0",
    "chalk": "^6.0.0",
    "cheerio": "^1.2.0",
    "chrome-launcher": "^1.2.1",
    "commander": "^15.0.0",
    "csp_evaluator": "^1.1.8",
    "geoip-lite": "^2.0.3",
    "jsdom": "^29.1.0",
    "lighthouse": "^13.4.1",
    "open-graph-scraper": "^6.12.0",
    "robots-parser": "^3.0.1",
    "ssl-checker": "^3.0.1",
    "wappalyzer-core": "^6.10.66",
    "whois-json": "^2.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.5"
  }
}
