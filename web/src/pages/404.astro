---
import Layout from "../layouts/Layout.astro";
import { kicker } from "../lib/ui";
---

<Layout title="Not found · Site Inspector">
  <div class="card mx-auto mt-10 max-w-lg p-8 text-center">
    <p class:list={[kicker, "mb-2"]}>404</p>
    <h1 class="text-2xl font-bold tracking-tight text-ink">Nothing here</h1>
    <p class="mt-2 text-ink-muted">That page doesn't exist.</p>
    <a
      href="/"
      class="mt-6 inline-block rounded bg-ink px-5 py-2.5 text-sm font-semibold text-surface hover:bg-accent"
    >
      Inspect a domain
    </a>
  </div>
</Layout>
