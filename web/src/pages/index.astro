---
import { availableChecks } from "site-inspector";
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import InspectForm from "../components/InspectForm.astro";
import { publicMode } from "../lib/network";

// The engine says which checks are heavy (launch Chrome or jsdom). Those are
// opt-in, and not offered at all in public mode (the API rejects them there).
const fastChecks = availableChecks({ heavy: false });
const heavyChecks = publicMode() ? [] : availableChecks({ heavy: true });
---

<Layout>
  <SiteHeader />
  <InspectForm fastChecks={fastChecks} heavyChecks={heavyChecks} />

  <!-- Screen readers hear start, finish, and errors here, not every progress tick. -->
  <p id="announcer" class="sr-only" aria-live="polite"></p>
  <div id="status" class="mt-6"></div>
  <div id="results" class="mt-8 transition-opacity"></div>
</Layout>

<script>
  import { renderResult } from "../lib/render";
  import { checkLabel } from "site-inspector/assess";
  import { NDJSON, readEvents, type StreamEvent } from "../lib/stream";
  import { cx, kicker, val } from "../lib/ui";

  const form = document.getElementById("inspect-form") as HTMLFormElement;
  const domainInput = document.getElementById("domain") as HTMLInputElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const cancelBtn = document.getElementById("cancel-btn") as HTMLButtonElement;
  const statusEl = document.getElementById("status") as HTMLDivElement;
  const resultsEl = document.getElementById("results") as HTMLDivElement;
  const announcer = document.getElementById("announcer") as HTMLParagraphElement;

  const fastChecks: string[] = JSON.parse(form.dataset.fastChecks ?? "[]");
  let controller: AbortController | null = null;

  function el(tag: string, className: string, text?: string): HTMLElement {
    const node = document.createElement(tag);
    node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  function announce(message: string): void {
    announcer.textContent = message;
  }

  // Status content includes user input and server messages, so it is built
  // with textContent — never innerHTML.
  function setStatus(...nodes: Node[]): void {
    statusEl.replaceChildren(...nodes);
  }

  /**
   * Live progress while an inspection runs: a bar for completed checks and a
   * list of the ones still in flight (useful when Lighthouse takes a while).
   */
  function progressStatus(domain: string) {
    const card = el("div", "card p-4");
    const head = el("div", "flex items-center gap-3");
    const spinner = el(
      "span",
      "inline-block h-4 w-4 shrink-0 rounded-full border-2 border-hairline-strong border-t-accent motion-safe:animate-spin",
    );
    spinner.setAttribute("aria-hidden", "true");
    const title = el("span", kicker, `Inspecting ${domain}…`);
    const count = el("span", cx(val, "ml-auto text-ink-muted"));
    head.append(spinner, title, count);

    const track = el("div", "mt-3 h-1.5 overflow-hidden rounded-full bg-hairline");
    const fill = el(
      "div",
      "h-full w-0 rounded-full bg-accent motion-safe:transition-[width] motion-safe:duration-300",
    );
    track.append(fill);
    track.setAttribute("role", "progressbar");
    track.setAttribute("aria-label", "Checks completed");
    track.setAttribute("aria-valuemin", "0");

    const detail = el("p", cx(val, "mt-2 text-ink-muted"), "Probing http/https and www endpoints…");
    card.append(head, track, detail);

    const running = new Set<string>();
    const showRunning = () => {
      const names = [...running].map(checkLabel);
      detail.textContent = names.length
        ? `Running: ${names.slice(0, 4).join(", ")}${names.length > 4 ? ` +${names.length - 4} more` : ""}`
        : "Finishing up…";
    };

    return {
      card,
      update(event: StreamEvent): void {
        if (event.type === "resolved") {
          if (event.checks.length === 0) detail.textContent = "The domain didn't respond.";
          count.textContent = `0 / ${event.checks.length}`;
          track.setAttribute("aria-valuemax", String(event.checks.length));
        } else if (event.type === "check-start") {
          running.add(event.check);
          showRunning();
        } else if (event.type === "check-done") {
          running.delete(event.check);
          count.textContent = `${event.completed} / ${event.total}`;
          fill.style.width = `${(event.completed / event.total) * 100}%`;
          track.setAttribute("aria-valuenow", String(event.completed));
          showRunning();
        }
      },
    };
  }

  function errorStatus(message: string): HTMLElement {
    const card = el("div", "card border-attention-border bg-attention-bg p-4");
    card.setAttribute("role", "alert");
    card.append(
      el("span", cx(kicker, "text-attention"), "Error"),
      document.createTextNode(" "),
      el("span", val, message),
    );
    return card;
  }

  /** While a run is in flight, the previous report stays visible but dimmed. */
  function setBusy(busy: boolean): void {
    submitBtn.disabled = busy;
    submitBtn.textContent = busy ? "Inspecting…" : "Inspect";
    cancelBtn.hidden = !busy;
    resultsEl.classList.toggle("opacity-40", busy);
    resultsEl.classList.toggle("pointer-events-none", busy);
    resultsEl.toggleAttribute("inert", busy);
    resultsEl.setAttribute("aria-busy", String(busy));
  }

  cancelBtn.addEventListener("click", () => controller?.abort());

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const domain = domainInput.value.trim();
    if (!domain) return;

    const heavy = Array.from(
      form.querySelectorAll<HTMLInputElement>('input[name="heavy-check"]:checked'),
    ).map((c) => c.value);
    const checks = [...fastChecks, ...heavy];

    controller = new AbortController();
    setBusy(true);
    const progress = progressStatus(domain);
    setStatus(progress.card);
    announce(`Inspecting ${domain}…`);

    try {
      const res = await fetch("/api/inspect", {
        method: "POST",
        headers: { "content-type": "application/json", accept: NDJSON },
        body: JSON.stringify({ domain, checks }),
        signal: controller.signal,
      });
      // Validation errors come back as plain JSON before any streaming starts.
      if (!res.ok || !res.body) {
        const body = await res.json().catch(() => null);
        throw new Error(body?.error ?? `Request failed (${res.status})`);
      }

      let finished = false;
      await readEvents(res.body, (event) => {
        if (event.type === "result") {
          finished = true;
          setStatus();
          setBusy(false);
          const attention = renderResult(event.result, resultsEl);
          document.body.classList.add("has-results");
          const heading = document.getElementById("report-title");
          heading?.focus();
          announce(
            `Inspection of ${domain} complete. ` +
              (attention === 0
                ? "Nothing needs attention."
                : `${attention} ${attention === 1 ? "item needs" : "items need"} attention.`),
          );
        } else if (event.type === "error") {
          throw new Error(event.error);
        } else {
          progress.update(event);
        }
      });
      if (!finished) throw new Error("The inspection ended unexpectedly.");
    } catch (err) {
      if (controller.signal.aborted) {
        setStatus();
        announce("Inspection canceled.");
      } else {
        const msg = err instanceof Error ? err.message : String(err);
        setStatus(errorStatus(msg));
      }
    } finally {
      setBusy(false);
      controller = null;
    }
  });
</script>
