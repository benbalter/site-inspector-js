---
import { availableChecks } from "site-inspector";
import Layout from "../layouts/Layout.astro";
import { checkLabel } from "site-inspector/assess";
import { publicMode } from "../lib/network";

// The engine says which checks are heavy (launch Chrome or jsdom). Those are
// opt-in, and not offered at all in public mode (the API rejects them there).
const fastChecks = availableChecks({ heavy: false });
const heavy = publicMode() ? [] : availableChecks({ heavy: true });
---

<Layout>
  <header class="mb-8">
    <div class="kicker mb-2">Domain diagnostics</div>
    <h1 class="text-4xl font-bold tracking-tight text-ink sm:text-5xl">Site Inspector</h1>
    <p class="mt-3 max-w-2xl text-ink-muted">
      A read on a domain's technology, security, and capabilities — with a clear call on what's
      healthy and what needs attention.
    </p>
    <a
      class="val mt-3 inline-block text-accent underline decoration-hairline-strong underline-offset-4 hover:text-ink"
      href="/api/openapi.json"
    >
      Machine-readable API spec (OpenAPI)
    </a>
  </header>

  <form id="inspect-form" class="card p-2" data-fast-checks={JSON.stringify(fastChecks)}>
    <div class="flex flex-col gap-2 sm:flex-row">
      <div class="flex flex-1 items-center gap-2 px-3">
        <span class="val text-ink-faint select-none">▸</span>
        <input
          id="domain"
          name="domain"
          type="text"
          required
          autofocus
          placeholder="example.com"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          class="val flex-1 bg-transparent py-3 text-base text-ink placeholder:text-ink-faint focus:outline-none"
        />
      </div>
      <button
        id="submit-btn"
        type="submit"
        class="inline-flex items-center justify-center gap-2 rounded-[4px] bg-ink px-6 py-3 text-sm font-semibold tracking-wide text-white transition hover:bg-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-60"
      >
        Inspect
      </button>
    </div>

    {heavy.length > 0 && (
      <details class="border-t border-hairline px-3 pb-3 pt-2">
        <summary class="kicker cursor-pointer list-none hover:text-accent">
          + Advanced — slower checks (launch headless Chrome)
        </summary>
        <div class="mt-3 flex flex-wrap gap-4">
          {heavy.map((name) => (
            <label class="flex cursor-pointer items-center gap-2 text-sm text-ink">
              <input
                type="checkbox"
                name="heavy-check"
                value={name}
                class="h-4 w-4 rounded border-hairline-strong text-accent focus:ring-accent"
              />
              {checkLabel(name)}
            </label>
          ))}
        </div>
      </details>
    )}
  </form>

  <div id="status" class="mt-6" aria-live="polite"></div>
  <div id="results" class="mt-8"></div>
</Layout>

<script>
  import { renderResult } from "../lib/render";
  import { checkLabel } from "site-inspector/assess";
  import { NDJSON, readEvents, type StreamEvent } from "../lib/stream";

  const form = document.getElementById("inspect-form") as HTMLFormElement;
  const domainInput = document.getElementById("domain") as HTMLInputElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const statusEl = document.getElementById("status") as HTMLDivElement;
  const resultsEl = document.getElementById("results") as HTMLDivElement;

  const fastChecks: string[] = JSON.parse(form.dataset.fastChecks ?? "[]");

  function el(tag: string, className: string, text?: string): HTMLElement {
    const node = document.createElement(tag);
    node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  // Status content includes user input and server messages, so it is built
  // with textContent — never innerHTML.
  function setStatus(...nodes: Node[]): void {
    statusEl.replaceChildren(...nodes);
  }

  /**
   * Live progress while an inspection runs: a bar for completed checks and a
   * list of the ones still in flight (useful when Lighthouse takes a while).
   */
  function progressStatus(domain: string) {
    const card = el("div", "card p-4");
    const head = el("div", "flex items-center gap-3");
    const spinner = el(
      "span",
      "inline-block h-4 w-4 shrink-0 animate-spin rounded-full border-2 border-hairline-strong border-t-accent",
    );
    const title = el("span", "kicker", `Inspecting ${domain}…`);
    const count = el("span", "val ml-auto text-ink-muted");
    head.append(spinner, title, count);

    const track = el("div", "mt-3 h-1.5 overflow-hidden rounded-full bg-hairline");
    const fill = el("div", "h-full w-0 rounded-full bg-accent transition-[width] duration-300");
    track.append(fill);
    track.setAttribute("role", "progressbar");
    track.setAttribute("aria-valuemin", "0");

    const detail = el("p", "val mt-2 text-ink-muted", "Probing http/https and www endpoints…");
    card.append(head, track, detail);

    const running = new Set<string>();
    const showRunning = () => {
      const names = [...running].map(checkLabel);
      detail.textContent = names.length
        ? `Running: ${names.slice(0, 4).join(", ")}${names.length > 4 ? ` +${names.length - 4} more` : ""}`
        : "Finishing up…";
    };

    return {
      card,
      update(event: StreamEvent): void {
        if (event.type === "resolved") {
          if (event.checks.length === 0) detail.textContent = "The domain didn't respond.";
          count.textContent = `0 / ${event.checks.length}`;
          track.setAttribute("aria-valuemax", String(event.checks.length));
        } else if (event.type === "check-start") {
          running.add(event.check);
          showRunning();
        } else if (event.type === "check-done") {
          running.delete(event.check);
          count.textContent = `${event.completed} / ${event.total}`;
          fill.style.width = `${(event.completed / event.total) * 100}%`;
          track.setAttribute("aria-valuenow", String(event.completed));
          showRunning();
        }
      },
    };
  }

  function errorStatus(message: string): HTMLElement {
    const card = el("div", "card border-[#f2c6c0] bg-[#fbe9e7] p-4");
    card.append(
      el("span", "kicker text-[#bd2f26]", "Error"),
      document.createTextNode(" "),
      el("span", "val text-ink", message),
    );
    return card;
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const domain = domainInput.value.trim();
    if (!domain) return;

    const heavy = Array.from(
      form.querySelectorAll<HTMLInputElement>('input[name="heavy-check"]:checked'),
    ).map((c) => c.value);
    const checks = [...fastChecks, ...heavy];

    submitBtn.disabled = true;
    resultsEl.replaceChildren();
    const progress = progressStatus(domain);
    setStatus(progress.card);

    try {
      const res = await fetch("/api/inspect", {
        method: "POST",
        headers: { "content-type": "application/json", accept: NDJSON },
        body: JSON.stringify({ domain, checks }),
      });
      // Validation errors come back as plain JSON before any streaming starts.
      if (!res.ok || !res.body) {
        const body = await res.json().catch(() => null);
        throw new Error(body?.error ?? `Request failed (${res.status})`);
      }

      let finished = false;
      await readEvents(res.body, (event) => {
        if (event.type === "result") {
          finished = true;
          setStatus();
          renderResult(event.result, resultsEl);
        } else if (event.type === "error") {
          throw new Error(event.error);
        } else {
          progress.update(event);
        }
      });
      if (!finished) throw new Error("The inspection ended unexpectedly.");
    } catch (err) {
      const msg = err instanceof Error ? err.message : String(err);
      setStatus(errorStatus(msg));
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>
