---
import { availableChecks } from "site-inspector";
import Layout from "../layouts/Layout.astro";
import { checkLabel } from "../lib/checkGroups";
import { publicMode } from "../lib/network";

// The engine says which checks are heavy (launch Chrome or jsdom). Those are
// opt-in, and not offered at all in public mode (the API rejects them there).
const fastChecks = availableChecks({ heavy: false });
const heavy = publicMode() ? [] : availableChecks({ heavy: true });
---

<Layout>
  <header class="mb-8">
    <div class="kicker mb-2">Domain diagnostics</div>
    <h1 class="text-4xl font-bold tracking-tight text-ink sm:text-5xl">Site Inspector</h1>
    <p class="mt-3 max-w-2xl text-ink-muted">
      A read on a domain's technology, security, and capabilities — with a clear call on what's
      healthy and what needs attention.
    </p>
  </header>

  <form id="inspect-form" class="card p-2" data-fast-checks={JSON.stringify(fastChecks)}>
    <div class="flex flex-col gap-2 sm:flex-row">
      <div class="flex flex-1 items-center gap-2 px-3">
        <span class="val text-ink-faint select-none">▸</span>
        <input
          id="domain"
          name="domain"
          type="text"
          required
          autofocus
          placeholder="example.com"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          class="val flex-1 bg-transparent py-3 text-base text-ink placeholder:text-ink-faint focus:outline-none"
        />
      </div>
      <button
        id="submit-btn"
        type="submit"
        class="inline-flex items-center justify-center gap-2 rounded-[4px] bg-ink px-6 py-3 text-sm font-semibold tracking-wide text-white transition hover:bg-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-60"
      >
        Inspect
      </button>
    </div>

    {heavy.length > 0 && (
      <details class="border-t border-hairline px-3 pb-3 pt-2">
        <summary class="kicker cursor-pointer list-none hover:text-accent">
          + Advanced — slower checks (launch headless Chrome)
        </summary>
        <div class="mt-3 flex flex-wrap gap-4">
          {heavy.map((name) => (
            <label class="flex cursor-pointer items-center gap-2 text-sm text-ink">
              <input
                type="checkbox"
                name="heavy-check"
                value={name}
                class="h-4 w-4 rounded border-hairline-strong text-accent focus:ring-accent"
              />
              {checkLabel(name)}
            </label>
          ))}
        </div>
      </details>
    )}
  </form>

  <div id="status" class="mt-6" aria-live="polite"></div>
  <div id="results" class="mt-8"></div>
</Layout>

<script>
  import { renderResult } from "../lib/render";
  import type { InspectionResult } from "site-inspector";

  const form = document.getElementById("inspect-form") as HTMLFormElement;
  const domainInput = document.getElementById("domain") as HTMLInputElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const statusEl = document.getElementById("status") as HTMLDivElement;
  const resultsEl = document.getElementById("results") as HTMLDivElement;

  const fastChecks: string[] = JSON.parse(form.dataset.fastChecks ?? "[]");

  function el(tag: string, className: string, text?: string): HTMLElement {
    const node = document.createElement(tag);
    node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  // Status content includes user input and server messages, so it is built
  // with textContent — never innerHTML.
  function setStatus(...nodes: Node[]): void {
    statusEl.replaceChildren(...nodes);
  }

  function loadingStatus(text: string): HTMLElement {
    const card = el("div", "card flex items-center gap-3 p-4");
    card.append(
      el(
        "span",
        "inline-block h-4 w-4 animate-spin rounded-full border-2 border-hairline-strong border-t-accent",
      ),
      el("span", "kicker", text),
    );
    return card;
  }

  function errorStatus(message: string): HTMLElement {
    const card = el("div", "card border-[#f2c6c0] bg-[#fbe9e7] p-4");
    card.append(
      el("span", "kicker text-[#bd2f26]", "Error"),
      document.createTextNode(" "),
      el("span", "val text-ink", message),
    );
    return card;
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const domain = domainInput.value.trim();
    if (!domain) return;

    const heavy = Array.from(
      form.querySelectorAll<HTMLInputElement>('input[name="heavy-check"]:checked'),
    ).map((c) => c.value);
    const checks = [...fastChecks, ...heavy];

    submitBtn.disabled = true;
    resultsEl.replaceChildren();
    const heavyNote = heavy.length
      ? " Running headless Chrome checks — this can take a while."
      : "";
    setStatus(loadingStatus(`Inspecting ${domain}…${heavyNote}`));

    try {
      const res = await fetch("/api/inspect", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ domain, checks }),
      });
      const body = await res.json();
      if (!res.ok) {
        throw new Error(body?.error ?? `Request failed (${res.status})`);
      }
      setStatus();
      renderResult(body as InspectionResult, resultsEl);
    } catch (err) {
      const msg = err instanceof Error ? err.message : String(err);
      setStatus(errorStatus(msg));
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>
