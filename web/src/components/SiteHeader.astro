---
import { kicker } from "../lib/ui";
---

<!-- Collapses to a compact title once a report is showing. -->
<header class="mb-8 group-[.has-results]/app:mb-5">
  <p class:list={[kicker, "mb-2 group-[.has-results]/app:hidden"]}>Domain diagnostics</p>
  <h1 class="text-4xl font-bold tracking-tight text-ink sm:text-5xl group-[.has-results]/app:text-2xl">
    Site Inspector
  </h1>
  <p class="mt-3 max-w-2xl text-ink-muted group-[.has-results]/app:hidden">
    A read on a domain's technology, security, and capabilities — with a clear call on what's
    healthy and what needs attention.
  </p>
</header>
