---
import { checkLabel } from "site-inspector/assess";
import { kicker, val } from "../lib/ui";

interface Props {
  fastChecks: string[];
  heavyChecks: string[];
}

const { fastChecks, heavyChecks } = Astro.props;
---

<form
  id="inspect-form"
  class="card p-2 focus-within:border-accent"
  data-fast-checks={JSON.stringify(fastChecks)}
>
  <div class="flex flex-col gap-2 sm:flex-row">
    <div class="flex flex-1 items-center gap-2 px-3">
      <label for="domain" class="sr-only">
        Domain to inspect
      </label>
      <span class:list={[val, "text-ink-faint select-none"]} aria-hidden="true">
        ▸
      </span>
      <input
        id="domain"
        name="domain"
        type="text"
        required
        autofocus
        placeholder="example.com"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        class:list={[
          val,
          "flex-1 bg-transparent py-3 text-base placeholder:text-ink-faint focus-visible:outline-none",
        ]}
      />
    </div>
    <div class="flex gap-2">
      <button
        id="submit-btn"
        type="submit"
        class="inline-flex flex-1 items-center justify-center gap-2 rounded bg-ink px-6 py-3 text-sm font-semibold tracking-wide text-surface transition-colors hover:bg-accent disabled:cursor-not-allowed disabled:opacity-60"
      >
        Inspect
      </button>
      <button
        id="cancel-btn"
        type="button"
        hidden
        class="rounded border border-hairline-strong px-4 py-3 text-sm font-medium text-ink-muted hover:border-accent hover:text-accent"
      >
        Cancel
      </button>
    </div>
  </div>

  {heavyChecks.length > 0 && (
    <details class="group/adv border-t border-hairline px-3 pt-2 pb-3">
      <summary class:list={[kicker, "cursor-pointer list-none hover:text-accent"]}>
        <span class="group-open/adv:hidden" aria-hidden="true">
          +
        </span>
        <span class="hidden group-open/adv:inline" aria-hidden="true">
          −
        </span>
        Advanced — slower checks (launch headless Chrome)
      </summary>
      <div class="mt-3 flex flex-wrap gap-4">
        {heavyChecks.map((name) => (
          <label class="flex cursor-pointer items-center gap-2 text-sm text-ink">
            <input type="checkbox" name="heavy-check" value={name} class="h-4 w-4 accent-accent" />
            {checkLabel(name)}
          </label>
        ))}
      </div>
    </details>
  )}
</form>
